' ShaGa IPTV Player — free player for your own M3U/M3U8 playlists
' ShaGa IPTV Player — бесплатный плеер для собственных плейлистов M3U/M3U8
'
' Interface languages: English, Spanish, Russian.
' Языки интерфейса: английский, испанский, русский.
' All three tables must have the same keys. / Во всех трёх таблицах одинаковые ключи.

function supportedLanguages() as object
    return ["en", "es", "ru"]
end function

' "auto" → system language if supported, else English
' "auto" → язык системы, если поддерживается, иначе английский
function resolveLanguage(pref as string) as string
    if pref = "en" or pref = "es" or pref = "ru" then return pref
    loc = LCase(CreateObject("roDeviceInfo").GetCurrentLocale())
    code = loc.Left(2)
    if code = "es" or code = "ru" then return code
    return "en"
end function

function getStrings(lang as string) as object
    if lang = "ru" then return stringsRu()
    if lang = "es" then return stringsEs()
    return stringsEn()
end function

