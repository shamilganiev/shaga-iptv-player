# ShaGa IPTV Player — free player for your own M3U/M3U8 playlists
# ShaGa IPTV Player — бесплатный плеер для собственных плейлистов M3U/M3U8
title=ShaGa IPTV Player
major_version=1
minor_version=3
build_version=0

# Store/home screen poster (FHD 540x405, HD 290x218, no transparency)
# Постер приложения (FHD 540x405, HD 290x218, без прозрачности)
mm_icon_focus_fhd=pkg:/images/poster_fhd.png
mm_icon_focus_hd=pkg:/images/poster_hd.png

# Splash screens (FHD 1920x1080, HD 1280x720)
# Заставки (FHD 1920x1080, HD 1280x720)
splash_screen_fhd=pkg:/images/splash_fhd.jpg
splash_screen_hd=pkg:/images/splash_hd.jpg
splash_color=#14121C
splash_min_time=0

ui_resolutions=fhd

# Required by certification since Oct 1, 2026 (needs Roku OS 15.1+)
# Обязательно для сертификации с 1 окт. 2026 (нужна Roku OS 15.1+)
rsg_version=1.3

# Deep linking while the app is running (roInputEvent)
# Deep linking во время работы приложения (roInputEvent)
supports_input_launch=1
