<?xml version="1.0" encoding="utf-8"?>
<!-- ShaGa IPTV Player — free player for your own M3U/M3U8 playlists -->
<!-- ShaGa IPTV Player — бесплатный плеер для собственных плейлистов M3U/M3U8 -->
<!-- Downloads and parses an M3U playlist in a background thread. -->
<!-- Загружает и разбирает плейлист M3U в фоновом потоке. -->
<component name="PlaylistLoader" extends="Task">
    <interface>
        <field id="playlistId" type="string" />
        <field id="url" type="string" />
        <!-- "net" = download + parse + save cache, "cache" = read cache only -->
        <!-- "net" = загрузка, разбор, запись кэша; "cache" = только чтение кэша -->
        <field id="mode" type="string" value="net" />
        <!-- { ok, playlistId, error, httpCode, channels: [...], groups: [ {name, idx} ] } -->
        <field id="result" type="assocarray" />
    </interface>
    <script type="text/brightscript" uri="PlaylistLoader.brs" />
    <script type="text/brightscript" uri="pkg:/source/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/log.brs" />
    <script type="text/brightscript" uri="pkg:/source/textutil.brs" />
</component>
