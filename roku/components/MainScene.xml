<?xml version="1.0" encoding="utf-8"?>
<!-- ShaGa IPTV Player — free player for your own M3U/M3U8 playlists -->
<!-- ShaGa IPTV Player — бесплатный плеер для собственных плейлистов M3U/M3U8 -->
<!-- Main scene: welcome screen, categories | channels | preview, full screen. -->
<!-- Главная сцена: приветствие, категории | каналы | предпросмотр, полный экран. -->
<component name="MainScene" extends="Scene">
    <interface>
        <!-- Deep link from main.brs: { contentId, mediaType } / Deep link из main.brs -->
        <field id="deepLink" type="assocarray" onChange="onDeepLink" />
        <!-- Set true to close the app (observed by main.brs) / true — закрыть приложение -->
        <field id="exitApp" type="boolean" value="false" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="MainScene.brs" />
    <script type="text/brightscript" uri="MainDialogs.brs" />
    <script type="text/brightscript" uri="MainSettings.brs" />
    <script type="text/brightscript" uri="MainPlayback.brs" />
    <script type="text/brightscript" uri="MainEpg.brs" />
    <script type="text/brightscript" uri="MainGuide.brs" />
    <script type="text/brightscript" uri="pkg:/source/catchup.brs" />
    <script type="text/brightscript" uri="pkg:/source/config.brs" />
    <script type="text/brightscript" uri="pkg:/source/log.brs" />
    <script type="text/brightscript" uri="pkg:/source/textutil.brs" />
    <script type="text/brightscript" uri="pkg:/source/strings.brs" />
    <script type="text/brightscript" uri="pkg:/source/storage.brs" />
    <script type="text/brightscript" uri="pkg:/source/groups.brs" />

    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x14121CFF" />

        <!-- Main screen / Главный экран -->
        <Group id="mainGroup" visible="false">
            <Label id="appTitle" translation="[100,48]" text="ShaGa IPTV Player" color="0xA995FFFF" font="font:MediumBoldSystemFont" />
            <Label id="playlistLabel" translation="[580,52]" width="1240" color="0xA39DB8FF" font="font:SmallSystemFont" />

            <!-- Column headers / Заголовки колонок -->
            <Label id="catHeader" translation="[100,108]" width="440" color="0xA995FFFF" font="font:SmallBoldSystemFont" />
            <Label id="chanHeader" translation="[580,108]" width="620" color="0xA995FFFF" font="font:SmallBoldSystemFont" />
            <Label id="videoHeader" translation="[1240,108]" width="580" color="0xA995FFFF" font="font:SmallBoldSystemFont" />

            <LabelList id="catList" translation="[100,156]" itemSize="[440,58]" numRows="13"
                color="0xECE9F6FF" focusedColor="0x14121CFF"
                focusBitmapUri="pkg:/images/focus.9.png" vertFocusAnimationStyle="floatingFocus" />

            <MarkupList id="chanList" translation="[580,156]" itemComponentName="ChannelItem"
                itemSize="[620,84]" numRows="9" itemSpacing="[0,0]"
                focusBitmapUri="pkg:/images/focus.9.png" vertFocusAnimationStyle="floatingFocus" />

            <!-- Loading / error message in the channel column / Загрузка и ошибки в колонке каналов -->
            <BusySpinner id="spinner" translation="[842,420]" visible="false" />
            <Label id="msgLabel" translation="[600,170]" width="580" height="700" wrap="true"
                color="0xECE9F6FF" font="font:SmallSystemFont" />

            <!-- Preview / Предпросмотр -->
            <Rectangle id="previewFrame" translation="[1240,156]" width="580" height="326" color="0x1D1A29FF" />
            <!-- Third column under the video: channel, programme on air, next ones -->
            <!-- Третья колонка под видео: канал, передача в эфире, следующие -->
            <Poster id="chLogo" translation="[1240,496]" width="64" height="48" loadDisplayMode="scaleToFit" />
            <Label id="chTitle" translation="[1320,494]" width="500" height="36" color="0xECE9F6FF" font="font:SmallBoldSystemFont" />
            <Label id="chGroup" translation="[1320,530]" width="500" height="28" color="0xA39DB8FF" font="font:SmallestSystemFont" />
            <Label id="nowTitle" translation="[1240,576]" width="580" height="40" color="0xECE9F6FF" font="font:MediumBoldSystemFont" />
            <Label id="nowTime" translation="[1240,618]" width="580" height="30" color="0xA39DB8FF" font="font:SmallestSystemFont" />
            <Rectangle id="nowBarBg" translation="[1240,654]" width="580" height="4" color="0x322D45FF" visible="false" />
            <Rectangle id="nowBar" translation="[1240,654]" width="0" height="4" color="0xA995FFFF" visible="false" />
            <Label id="nowDesc" translation="[1240,670]" width="580" height="124" wrap="true" maxLines="4"
                color="0xA39DB8FF" font="font:SmallestSystemFont" />
            <Label id="nextList" translation="[1240,800]" width="580" height="108" wrap="true" maxLines="4"
                color="0xD0CCE0FF" font="font:SmallestSystemFont" />
            <!-- Programme list of one channel (Right from the channel list) / Список передач канала -->
            <LabelList id="progList" translation="[1240,572]" itemSize="[580,46]" numRows="6" visible="false"
                color="0xECE9F6FF" focusedColor="0x14121CFF" font="font:SmallestSystemFont"
                focusBitmapUri="pkg:/images/focus.9.png" vertFocusAnimationStyle="floatingFocus" />
            <Label id="progDesc" translation="[1240,852]" width="580" height="54" wrap="true" maxLines="2" visible="false"
                color="0xA39DB8FF" font="font:SmallestSystemFont" />
            <Label id="previewStatus" translation="[1240,906]" width="580" height="32"
                color="0xA995FFFF" font="font:SmallestSystemFont" />

            <Label id="hintLabel" translation="[100,950]" width="1720" color="0xA39DB8FF" font="font:SmallestSystemFont" />
        </Group>

        <Video id="video" translation="[1240,156]" width="580" height="326" enableUI="false" visible="false" />
        <!-- Our buffering spinner over the video / Наш значок загрузки поверх видео -->
        <BusySpinner id="vSpinner" visible="false" />

        <!-- Full screen info / Информация в полноэкранном режиме -->
        <Group id="osd" visible="false">
            <Rectangle translation="[0,860]" width="1920" height="220" color="0x000000C0" />
            <Label id="osdTitle" translation="[120,890]" width="1680" color="0xFFFFFFFF" font="font:LargeBoldSystemFont" />
            <Label id="osdSub" translation="[120,960]" width="1680" color="0xD0CCE0FF" font="font:SmallSystemFont" />
            <Label id="osdHint" translation="[120,1010]" width="1680" color="0xA39DB8FF" font="font:SmallestSystemFont" />
        </Group>

        <!-- Welcome / Приветствие -->
        <Group id="welcome" visible="false">
            <Label id="wTitle" translation="[240,300]" width="1440" horizAlign="center" color="0xECE9F6FF" font="font:LargeBoldSystemFont" />
            <Label id="wText" translation="[360,400]" width="1200" wrap="true" horizAlign="center" color="0xA39DB8FF" font="font:MediumSystemFont" />
            <Label id="wHint" translation="[240,600]" width="1440" horizAlign="center" color="0xA995FFFF" font="font:MediumBoldSystemFont" />
            <Label id="wTip" translation="[410,690]" width="1100" wrap="true" horizAlign="center" color="0xA39DB8FF" font="font:SmallSystemFont" />
        </Group>

        <!-- Receives keys when no list should have focus / Ловит кнопки, когда списки без фокуса -->
        <Group id="keyCatcher" focusable="true" />

        <Timer id="catTimer" duration="0.25" repeat="false" />
        <Timer id="osdTimer" duration="4" repeat="false" />
        <Timer id="launchTimer" duration="10" repeat="false" />
        <Timer id="spinTimer" duration="0.7" repeat="false" />
        <Timer id="startTimer" duration="45" repeat="false" />
        <Timer id="lockTimer" duration="30" repeat="true" />
        <Timer id="epgStartTimer" duration="1.5" repeat="false" />
    </children>
</component>
